erySelectorAll('.pb-1.text-start.text-sm.tracking-tight');\\n    if (items.length) {\\n        window.cartArrayCyb = [], window.cartItemSkusCyb = [];\\n        let cybProdParse = function (item) {\\n            let _id = item.innerText.trim();\\n            cartArrayCyb.push({ id: _id })\\n            cartItemSkusCyb.push(_id)\\n        };\\n        Array.from(items).forEach(cybProdParse)\\n        localStorage['ProdArrCyb'] = JSON.stringify(cartArrayCyb);\\n        localStorage['skuArrCyb'] = JSON.stringify(cartItemSkusCyb.join())\\n        clearInterval(cybProdArrInt);\\n    }\\n};\\nlet cybProdArrInt = setInterval(setProdIds, 1500);\\n\\n\\nif(!!~window.location.href.indexOf('collections') && !!~window.location.href.indexOf('.html') && document.querySelector('.js-pdp__cta-section--product-ref-id .local-ref') !== null){\\n    try{\\n        if(document.querySelectorAll('.product-sku-sizes.button.tiny.in-stock')){\\n           window.cybSKU = document.querySelector('.js-pdp__cta-section--product-ref-id .local-ref').innerText.toLowerCase();\\n           window._vteq.push({\\n               \\\"viewitem\\\": {\\n                   itemId: cybSKU\\n               }\\n           });\\n        }\\n        if(document.querySelector('.btn-add-to-basket')){\\n            document.querySelector('.btn-add-to-basket').addEventListener(\\\"click\\\",function(){\\n                window._vteq.push({\\n                    addtocart: {\\n                        itemId: cybSKU,\\n                        cartId: Date.now()\\n                    }\\n                });\\n            });\\n        }\\n    }catch(e){}\\n}else if(window.location.href.toLowerCase().indexOf(\\\"search-results.html?kwcar=\\\") >= 0){\\n    window._vteq.push({\\n        \\\"search\\\": {\\n            query: decodeURIComponent(urlParamCYB('kwCAR'))\\n        }\\n    });\\n}\\nwindow.upDateUserIDCYB =  function(){\\n    if(!!~window.location.search.indexOf('vt_user')){\\n        let cybID=urlParamCYB('vt_user');        \\n        setCookieCYB('CYB_ID', cybID);\\n    }\\n}\\nwindow.waitForTotalElementCYB=function(){\\n    if(document.querySelector('.price .value') && document.querySelector('.price .value').getAttribute('data-ytos-price') && !!~window.location.href.toLowerCase().indexOf('onepagecheckout')) {\\n        setCookieCYB('cybPrice',document.querySelector('.price .value').getAttribute('data-ytos-price'))\\n    }else{\\n        setTimeout(waitForTotalElementCYB, 250);\\n    }\\n}\\n// this embeds the campaigns into the onsite or on a site\\nwindow.cybReccomender = function(){\\n    _vtsdk.Recommender.embedMerchandisingCampaigns();\\n    _vtsdk.Recommender.getData();\\n}\\n\\n\\n\\nwindow.getCartCountCYB=function(){\\n    // 1. Select the host web component\\n    const host = document.querySelector('mini-bag-webcomponent');\\n    \\n    if (!host || !host.shadowRoot) {\\n        console.warn(\\\"Mini-bag component or shadowRoot not found.\\\");\\n        return null;\\n    }\\n\\n    // 2. Query inside the shadow root\\n    // We target the nested span. Based on your image, it has unique classes starting with #.\\n    // Using the class '#15he328' (from your highlighted line) or a more generic selector:\\n    const countElement = host.shadowRoot.querySelector('button span span');\\n\\n    return countElement ? countElement.innerText.trim() : null;\\n}\\n\\n\\nif( Number(getCartCountCYB()) > 0){\\nif(document.querySelector('.breadcrumbs .crumb.level_2 a') || document.querySelector('[data-page-type=\\\"PDP\\\"]') && (typeof google_tag_manager !== 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'] !== 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'].dataLayer != 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'].dataLayer.get('ecommerce') !== 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'].dataLayer.get('ecommerce').items !== 'undefined'  && google_tag_manager['GTM-N8NZFKXD'].dataLayer.get('ecommerce').items[0].index > 0)){\\n  //  let breadcrumbUrl = document.querySelector('.breadcrumbs .crumb.level_2 a').href\\n    let breadcrumbUrl = window.location.href;\\n    if (!!~breadcrumbUrl.indexOf('watch')) {\\n        _vteq.push({\\n            'event': {\\n                'event_name': 'category',\\n                'lang': document.querySelector('html').lang,\\n                'cat': 'watch'\\n            }\\n        });\\n    } else if (!!~breadcrumbUrl.indexOf('tasche') || !!~breadcrumbUrl.indexOf('leather')) {\\n        _vteq.push({\\n            'event': {\\n                'event_name': 'category',\\n                'lang': document.querySelector('html').lang,\\n                'cat': 'leather'\\n            }\\n        });\\n    } else if (!!~breadcrumbUrl.indexOf('schmuck') || !!~breadcrumbUrl.indexOf('jewellery') || !!~breadcrumbUrl.indexOf('joaillerie')) {\\n        _vteq.push({\\n            'event': {\\n                'event_name': 'category',\\n                'lang': document.querySelector('html').lang,\\n                'cat': 'jewelry'\\n            }\\n        });\\n    } else{\\n        _vteq.push({\\n          'event': {\\n              'event_name': 'category',\\n                'lang': document.querySelector('html').lang,\\n              'cat': 'jewelry'\\n          }\\n        });\\n    }\\n}else if (document.querySelector('.iconbox__number.js-cart-count') && document.querySelector(\\\".row.c-collection-block,.c-collection-link,.listing-heading.view-specific,.c-pdp__cta-section--product-description\\\") && document.querySelector(\\\".c-breadcrumb__list-item.active\\\")) {\\n    if (Number(document.querySelector('.iconbox__number.js-cart-count').innerText) > 0) {\\n        if (!!~window.location.pathname.indexOf('uhren')) {\\n            _vteq.push({\\n                'event': {\\n                    'event_name': 'category',\\n                'lang': document.querySelector('html').lang,\\n                    'cat': 'watch'\\n                }\\n            });\\n        } else if