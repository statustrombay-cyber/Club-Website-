ndow.checkCartCategories = function () {\\n    if ((document.querySelector('.cart-list-item .cart-list-item__image a') && (!!~window.location.href.indexOf('/Cart')) && document.querySelector('html').lang === 'en') || typeof google_tag_manager !== 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'] !== 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'].dataLayer != 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'].dataLayer.get('ecommerce') !== 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'].dataLayer.get('ecommerce').items !== 'undefined' && typeof google_tag_manager['GTM-N8NZFKXD'].dataLayer.get('ecommerce').items[0].item_category !== 'undefined') {\\n        // var firstItemLink = document.querySelector('.cart-list-item .cart-list-item__image a').href; //DE doesnt have category information in the link, using alt text below\\n       // let firstItemLink = document.querySelector('.cart-list-item .cart-list-item__image a img').alt.toLowerCase();\\n        let firstItemLink = google_tag_manager['GTM-N8NZFKXD'].dataLayer.get('ecommerce').items[0].item_category.toLowerCase()\\n        var watchCategory = \\\"watch\\\";\\n        var leatherCategory = \\\"leather\\\";\\n        var jewelryCategory = \\\"joaillerie\\\";\\n        let engagementCategory = \\\"engagement\\\";\\n        let fragranceCategory = \\\"toilette\\\";\\n        var category = \\\"jewelry\\\";\\n        if (!!~firstItemLink.indexOf(watchCategory)) {\\n            category = 'watch'\\n        } else if (!!~firstItemLink.indexOf(leatherCategory)) {\\n            category = 'leather'\\n        } else if (!!~firstItemLink.indexOf(engagementCategory)) {\\n            category = 'engagement'\\n        } else if (!!~firstItemLink.indexOf(fragranceCategory)) {\\n            category = 'fragrances'\\n        } else if (!!~firstItemLink.indexOf(jewelryCategory)) {\\n            category = 'jewelry'\\n        }else\\n            category = 'jewelry'\\n        return category;\\n    } else if (document.querySelector('.cart-list-item .cart-list-item__image a') && (!!~window.location.href.indexOf('Cart')) && document.querySelector('html').lang === 'de') {\\n        // var firstItemLink = document.querySelector('.cart-list-item .cart-list-item__image a').href; //DE doesnt have category information in the link, using alt text below\\n        let firstItemLink = document.querySelector('.cart-list-item .cart-list-item__image a img').alt.toLowerCase();\\n        \\n        var watchCategory = /tank|orologio|reloj|uhren/;\\n        var leatherCategory = /leather/;\\n        var jewelryCategory = /jewelry/;\\n        let engagementCategory = /engagement/;\\n        let fragranceCategory = /toilette/;\\n        var category = \\\"jewelry\\\";\\n        if (firstItemLink.match(watchCategory)) {\\n            category = 'watch'\\n        } else if (firstItemLink.match(leatherCategory)) {\\n            category = 'leather'\\n        } else if (firstItemLink.match(engagementCategory)) {\\n            category = 'engagement'\\n        } else if (firstItemLink.match(fragranceCategory)) {\\n            category = 'fragrances'\\n        } else if (firstItemLink.match(jewelryCategory)) {\\n            category = 'jewelry'\\n        }\\n        return category;\\n    }\\n}\\n\\n\\n\\nfunction waitForCartElementCYB() {\\n    if (document.querySelector('cart-list-item .cart-list-item__name, [data-testid=\\\"cart-product-card-title\\\"]') && document.querySelector('cart-list-item .image-wrapper a img, [data-testid=\\\"cart-product-card-image\\\"]') /*&& document.querySelector('cart-list-item .cart-list-item__short-description, .decoration-none.pb-2.text-left.font-fancy, .pb-1.pr-10.line-clamp-1')*/ && document.querySelector('cart-list-item .cart-list-item__price .full.price .value, .mb-2.grid span')) {\\n        window._vteq = window._vteq || [];\\n        var cybProductName = document.querySelector('cart-list-item .cart-list-item__name, [data-testid=\\\"cart-product-