# Mindfultattva — static single-page build (all routes are served by index.html)

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/javascript            .js
  AddType application/wasm                  .wasm
  AddType image/webp                        .webp
  AddType image/ktx2                        .ktx2
  AddType image/svg+xml                     .svg
  AddType font/woff2                        .woff2
  AddType model/gltf-binary                 .glb
  AddType video/mp4                         .mp4
  AddType audio/mpeg                        .mp3
  AddType audio/wav                         .wav
  AddType application/json                  .json
  AddType image/x-exr                       .exr
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files and folders exactly as they are (assets, models, textures…).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp  "access plus 30 days"
  ExpiresByType image/png   "access plus 30 days"
  ExpiresByType image/jpeg  "access plus 30 days"
  ExpiresByType font/woff2  "access plus 1 year"
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType application/wasm  "access plus 30 days"
</IfModule>
