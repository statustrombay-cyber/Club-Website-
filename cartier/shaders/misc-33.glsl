vec2 getBumpUV(in vec2 uv){vec2 uvBump=vec2(uv.x,uv.y);if(uBumpFlip>0.0){uvBump.y=1.0-uvBump.y;}return uvBump;}vec2 parallaxOcclusion(in vec2 uv,in vec3 v){vec2 uvBump=getBumpUV(uv);float minLayers=floor(uLayerRange.x);float maxLayers=floor(uLayerRange.y);float numLayers=mix(maxLayers,minLayers,max(0.0,dot(-v,vec3(0.0,0.0,1.0))));float layerDepth=1.0/numLayers;float currentLayerDepth=0.0;vec2 p=v.xy*uHeightStrength;vec2 deltaCoord=p/numLayers;vec2 currentPos=uvBump;float currentDepth=texture(tBump,uvBump).x;while(currentLayerDepth<currentDepth){currentPos-=deltaCoord;currentDepth=texture(tBump,currentPos).x;currentLayerDepth+=layerDepth;}vec2 prevCoord=currentPos+deltaCoord;float afterDepth=currentDepth-currentLayerDepth;float beforeDepth=texture(tBump,prevCoord).x-currentLayerDepth+layerDepth;float weight=afterDepth/(afterDepth-beforeDepth);vec2 finalUV=prevCoord*weight+currentPos*(1.0-weight);if(uBumpFlip>0.0){finalUV.y=1.0-finalUV.y;}return finalUV;}
