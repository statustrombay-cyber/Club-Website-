uniform sampler2D tMap;uniform vec2 uResolution;uniform float uTime;uniform float uSeed;in vec2 vUv;out vec4 FragColor;vec4 hash42(vec2 p){vec4 p4=fract(vec4(p.xyxy)*vec4(.1031,.1030,.0973,.1099));p4+=dot(p4,p4.wzxy+33.33);return fract((p4.xxyz+p4.yzzw)*p4.zywx);}vec4 downsample(vec2 uv,vec2 halfpixel){vec4 sum=texture(tMap,uv)*4.0;sum+=texture(tMap,uv-halfpixel.xy);sum+=texture(tMap,uv+halfpixel.xy);sum+=texture(tMap,uv+vec2(halfpixel.x,-halfpixel.y));sum+=texture(tMap,uv-vec2(halfpixel.x,-halfpixel.y));return sum/8.0;}void main(){vec2 resolution=vec2(textureSize(tMap,0));FragColor=downsample(vUv,(1.0/resolution)*0.5);vec4 hash1=hash42(gl_FragCoord.xy+fract(uTime)*1300.0+uSeed*150.0);vec4 hash2=hash42(gl_FragCoord.yx+fract(uTime+0.3123)*1300.0+uSeed*137.0);vec4 dither=(hash1+(hash2-1.0))/255.0;}
