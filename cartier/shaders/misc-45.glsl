uniform sampler2D tMap;uniform sampler2D tNoise;uniform float uTime;uniform float uBlur;uniform float uBlurStrength;in vec2 vUv;out vec4 FragColor;void main(){vec2 texSize=vec2(textureSize(tMap,0));vec2 uv=2.0*vUv-1.0;uv*=texSize.x>texSize.y ? vec2(texSize.x/texSize.y,1.0): vec2(1.0,texSize.y/texSize.x);vec2 absCoord=abs(uv);float blurMask=step(absCoord.x,0.8)*step(absCoord.y,0.8);if(uBlur<=0.0||uBlur>=1.0||blurMask<=0.0){FragColor=texture(tMap,vUv);return;}vec4 col=vec4(0.0);float noise=texture(tNoise,(gl_FragCoord.xy+fract(uTime)*1000.0)/256.0).x;noise=2.0*noise-1.0;float stpCount=10.0;vec2 stp=1.0/texSize;float weight=0.0;float blurPhase=1.0-abs(2.0*uBlur-1.0);for(float i=-2.0;i<=2.0;i++){weight+=1.0;col+=texture(tMap,vUv+vec2(i+noise,0.0)*stp*blurPhase*uBlurStrength);}FragColor=col/weight;}
