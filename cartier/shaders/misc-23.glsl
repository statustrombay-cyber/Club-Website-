#define GLSLIFY 1
const float COLOR_UTILS_EPSILON=1e-10;vec3 _hueToRGB(in float hue){vec3 rgb=abs(hue*6.0-vec3(3.0,2.0,4.0))*vec3(1.0,-1.0,-1.0)+vec3(-1.0,2.0,2.0);return clamp(rgb,0.0,1.0);}vec3 _rgbToHCV(in vec3 rgb){vec4 p=(rgb.g<rgb.b)? vec4(rgb.bg,-1.0,2.0/3.0): vec4(rgb.gb,0.0,-1.0/3.0);vec4 q=(rgb.r<p.x)? vec4(p.xyw,rgb.r): vec4(rgb.r,p.yzx);float c=q.x-min(q.w,q.y);float h=abs((q.w-q.y)/(6.0*c+COLOR_UTILS_EPSILON)+q.z);return vec3(h,c,q.x);}vec3 rgbToHSW(in vec3 rgb){vec3 hcv=_rgbToHCV(rgb);float z=hcv.z-hcv.y*0.5;float s=hcv.y/(1.0-abs(z*2.0-1.0)+COLOR_UTILS_EPSILON);return vec3(hcv.x,s,z);}vec3 hswToRGB(in vec3 hsw){vec3 rgb=_hueToRGB(hsw.x);float c=(1.0-abs(2.0*hsw.z-1.0))*hsw.y;return(rgb-0.5)*c+hsw.z;}vec3 saturation(vec3 rgb,float adjustment){float luma=dot(rgb,vec3(0.2126,0.7152,0.0722));return mix(vec3(luma),rgb,adjustment);}
