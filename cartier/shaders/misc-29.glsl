vec3 sinNoise(vec3 seed,float fallOff,int octaves){vec3 noise=vec3(0.0);float amp=1.0;float freq=1.0;vec3 s=seed;const float _cos=-0.7373689;const float _sin=0.6754903;mat3 mat=mat3(_cos,_sin*_sin,_sin*_cos,0.0,_cos,-_sin,-_sin,_cos*_sin,_cos*_cos);for(int i=0;i<octaves;i++){s=mat*s;noise+=sin(s.zxy*freq)*amp;amp*=fallOff;freq/=fallOff;s+=noise;}return noise;}vec3 sinNoiseDeriv(vec3 seed,float fallOff,int octaves){vec3 noise=vec3(0.0);float amp=1.0;float freq=1.0;vec3 s=seed;const float _cos=-0.7373689;const float _sin=0.6754903;mat3 mat=mat3(_cos,_sin*_sin,_sin*_cos,0.0,_cos,-_sin,-_sin,_cos*_sin,_cos*_cos);for(int i=0;i<octaves;i++){s=mat*s;noise+=cos(s.zxy*freq)*amp;amp*=fallOff;freq/=fallOff;s+=noise;}return noise;}
