# Mindful Tattva · Apache configuration
# --------------------------------------------------------------------------
# A single static page and the room it loads. No backend, no database, no
# framework: everything the visitor sees is already on disk.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dot files (.gitignore, .htaccess, .git) are never served.
  RewriteRule (^|/)\. - [F,L]

  # Notes and tooling are not part of the site.
  RewriteRule ^(README|package(-lock)?\.json|\.gitattributes) - [F,L]
  RewriteRule \.(md|mjs|log|lock|tmp|sql|bak|example)$ - [F,L]

  # Real files (the page, the stylesheet, the room, the fonts) go straight
  # out; everything else is the one page.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# The room's file types.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType application/wasm .wasm
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType audio/wav .wav
  AddType application/json .json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # The room is heavy: let the browser keep it.
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType application/wasm "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType audio/wav "access plus 30 days"
  # The page itself is never stale.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
