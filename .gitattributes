# ---------------------------------------------------------------------------
# Mindful Tattva — what GitHub must NOT put in the "Download ZIP" archive.
#
# The archive a visitor downloads has to be the working website and nothing
# else: the page, the room, the fonts, the sound. Every reference dump, every
# recording, every tool and every stray archive is kept out of the export
# while staying in the history of the repository.
# ---------------------------------------------------------------------------

# Recordings and design references.
screen-*.mp4 export-ignore
/*.mp4 export-ignore
/tools/references/*.mp4 export-ignore
/part_* export-ignore

# Local rollback folders and uploaded archives.
/.rollback/ export-ignore
/*.zip export-ignore
/*.rar export-ignore
/*.7z export-ignore

# Development tooling: it stays in Git, it never ships.
/tools/ export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/yarn.lock export-ignore

# Notes.
/README.md export-ignore
*.md export-ignore

# The uploaded study references that were recovered from the club's history.
/cartier-part-* export-ignore
/cartierfile*.rar export-ignore
/cartier* export-ignore
/cartier/ export-ignore
/reference* export-ignore
/*.glb export-ignore
/*.html export-ignore

# Private club data must never be overwritten by an extraction.
/data/site.json export-ignore
/data/config.php export-ignore
/app/ export-ignore
/views/ export-ignore
/uploads/ export-ignore

# Keep the scripts that make the room readable.
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.glsl text eol=lf
*.md text eol=lf

# The heavy room files are binary.
*.glb binary
*.wav binary
*.woff2 binary
*.webp binary
*.exr binary
*.png binary
*.jpg binary
