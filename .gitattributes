# Recordings are design references, never part of GitHub source ZIP downloads.
screen-*.mp4 export-ignore
/tools/references/*.mp4 export-ignore

# Never export local rollback archives or uploaded root recordings.
/.rollback/ export-ignore
/*.mp4 export-ignore

# Any re-uploaded reference dumps must stay out of source/deployment exports.
/part_* export-ignore

/university*.html export-ignore

# Uploaded reference archives are never deployable runtime files.
/*.zip export-ignore
