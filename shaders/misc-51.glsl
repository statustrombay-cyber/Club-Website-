float hash14(vec4 p4){p4=fract(p4*vec4(.1031,.1030,.0973,.1099));p4+=dot(p4,p4.wzxy+33.33);return fract((p4.x+p4.y)*(p4.z+p4.w));}vec2 rayBoxIntersect(vec3 rayOrigin,vec3 rayDir,vec3 boxMin,vec3 boxMax){vec3 tBot=(boxMin-rayOrigin)/rayDir;vec3 tTop=(boxMax-rayOrigin)/rayDir;vec3 tNear=min(tBot,tTop);vec3 tFar=max(tBot,tTop);float t0=max(max(tNear.x,tNear.y),tNear.z);float t1=min(min(tFar.x,tFar.y),tFar.z);return vec2(t0,t1);}float coneMask(vec3 pos){vec3 d=normalize(vec3(0.0,0.0,1.0)-pos);float dDotDir=max(0.0,dot(d,vec3(0.0,0.0,1.0)));return smoothstep(0.85,1.0,dDotDir);}float boxFallOff(vec3 p){vec3 normCoord=p;vec3 fallOff=smoothstep(1.0,0.9,abs(normCoord));return fallOff.x*fallOff.y*fallOff.z;}vec2 raymarch(vec3 rayOrigin,vec3 rayDir){vec3 _min=vec3(-1.0);vec3 _max=vec3(1.0);vec2 t=rayBoxIntersect(rayOrigin,rayDir,_min,_max);if(t.x>t.y||t.y<0.001)return vec2(0.0,0.0);float start=max(t.x,0.0);float end=t.y;float marchDist=end-start;int STEPS=5;float stpSize=marchDist/float(STEPS);float hash=hash14(vec4((rayOrigin+rayDir*start)*10000.0,uTime));start+=(hash-0.0)*stpSize*0.2;float density=uDensity;float transmittance=1.0;float totalLight=0.0;for(int i=0;i<STEPS;i++){float currentT=start+(float(i)+0.5)*stpSize;if(currentT>end)break;vec3 p=rayOrigin+rayDir*currentT;vec3 seed=p;seed.z=0.0;vec3 noise=sinNoise(vec3(seed.zyx*vec3(8.4)+vec3(uTime,0.0,0.0)),0.516,1);float fade=boxFallOff(p);p+=noise*0.8*fade*(1.0-(vPos.z*0.5+0.5));float mask=coneMask(p);float extinction=exp(-density*stpSize*mask*fade);float currentTransmittance=1.0-extinction;totalLight+=transmittance*currentTransmittance;transmittance*=extinction;if(transmittance<0.001)break;}return vec2(totalLight,transmittance);}void main(){vec3 rayDir=normalize(vPos-vObjectRayOrigin.xyz);vec2 res=raymarch(vObjectRayOrigin.xyz,rayDir);float phase=(vPos.z*0.5+0.5);FragColor[0]=vec4(mix(vec3(1.0),uTintColor,1.0-res.x)*res.x,res.x)*(1.0-res.y)*smoothstep(0.0,1.0,phase)*uAlpha;FragColor[1]=vec4(0.0);}
