#define GLSLIFY 1
vec4 _hash42(vec2 p){vec4 p4=fract(vec4(p.xyxy)*vec4(.1031,.1030,.0973,.1099));p4+=dot(p4,p4.wzxy+33.33);return fract((p4.xxyz+p4.yzzw)*p4.zywx);}vec3 _hash32(vec2 p){vec3 p3=fract(vec3(p.xyx)*vec3(.1031,.1030,.0973));p3+=dot(p3,p3.yxz+33.33);return fract((p3.xxy+p3.yzz)*p3.zyx);}vec4 dither(vec4 col,float time){vec4 hash1=_hash42(gl_FragCoord.xy+fract(time)*1300.0);vec4 hash2=_hash42(gl_FragCoord.yx+fract(time+0.3123)*1300.0);vec4 dither=(hash1+(hash2-1.0))/255.0;return col+dither;}vec3 dither(vec3 col,float time){vec3 hash1=_hash32(gl_FragCoord.xy+fract(time)*1300.0);vec3 hash2=_hash32(gl_FragCoord.yx+fract(time+0.3123)*1300.0);vec3 dither=(hash1+(hash2-1.0))/255.0;return col+dither;}
