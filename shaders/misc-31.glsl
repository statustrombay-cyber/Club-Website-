vec2 getBumpUV(in vec2 uv){vec2 uvBump=uv;if(uBumpFlip>0.0){uvBump.y=1.0-uvBump.y;}return uvBump;}vec2 parallaxMap(in vec2 uv,in vec3 v){vec2 uvBump=getBumpUV(uv);float minLayers=floor(uLayerRange.x);float maxLayers=floor(uLayerRange.y);float numLayers=mix(maxLayers,minLayers,max(0.0,dot(-v,vec3(0.0,0.0,1.0))));float layerDepth=1.0/numLayers;float currentLayerDepth=0.0;vec2 p=v.xy*uHeightStrength;vec2 deltaCoord=p/numLayers;vec2 currentPos=uv;float currentDepth=texture(tBump,uv).x;while(currentLayerDepth<currentDepth){currentPos-=deltaCoord;currentDepth=texture(tBump,currentPos).x;currentLayerDepth+=layerDepth;}return currentPos;}
