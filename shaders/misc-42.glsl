uniform sampler2D tMap;uniform sampler2D tBloom;uniform float uTime;uniform float uBloomIntensity;uniform float uGlowIntensity;in vec2 vUv;out vec4 FragColor[2];vec3 screenBlend(vec3 a,vec3 b){return 1.0-((1.0-a)*(1.0-b));}vec4 screenBlend(vec4 a,vec4 b){return 1.0-((1.0-a)*(1.0-b));}vec3 hash32(vec2 p){vec3 p3=fract(vec3(p.xyx)*vec3(.1031,.1030,.0973));p3+=dot(p3,p3.yxz+33.33);return fract((p3.xxy+p3.yzz)*p3.zyx);}vec4 hash42(vec2 p){vec4 p4=fract(vec4(p.xyxy)*vec4(.1031,.1030,.0973,.1099));p4+=dot(p4,p4.wzxy+33.33);return fract((p4.xxyz+p4.yzzw)*p4.zywx);}vec2 hash22(vec2 p){vec3 p3=fract(vec3(p.xyx)*vec3(.1031,.1030,.0973));p3+=dot(p3,p3.yzx+33.33);return fract((p3.xx+p3.yz)*p3.zy);}void main(){vec4 col=texture(tMap,vUv);vec4 bloom=texture(tBloom,vUv);float bloomIntensity=uBloomIntensity;col=screenBlend(col,bloom*uBloomIntensity);vec4 hash1=hash42(gl_FragCoord.xy+fract(uTime)*1300.0);vec4 hash2=hash42(gl_FragCoord.yx+fract(uTime+0.3123)*1300.0);vec4 dither=(hash1+(hash2-1.0))/255.0;col+=dither;FragColor[0]=col;FragColor[1]=vec4(0.0);}
