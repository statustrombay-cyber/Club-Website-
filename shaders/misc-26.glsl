float linearizeDepth(float depth){float near=0.1;float far=500.0;float z=depth*2.0-1.0;return(2.0*near*far)/(far+near-z*(far-near));}float linearizeDepth(float depth,float near,float far){float z=depth*2.0-1.0;return(2.0*near*far)/(far+near-z*(far-near));}float linearizeDepth01(float depth,float near,float far){float z=depth*2.0-1.0;return(2.0*near*far)/(far+near-z*(far-near))/(far-near);}
