ing-xs, 12px));--organisms-pbl-active-title-color: var( --organisms-step-header-active-text-color, var(--color-text-primary, #0d0d0d) );--organisms-pbl-active-title-line-height: var(--pbl-line-height-flat, 100%);--organisms-pbl-active-title-margin-top: var(--spacing-none, 0px);--organisms-pbl-active-title-margin-bottom: var(--spacing-none, 0px);--organisms-pbl-active-step-content-min-height: var(--size-pbl-active-step-content-min, 380px);--organisms-pbl-active-step-inner-padding-top: var(--spacing-none, 0px);--organisms-pbl-active-step-inner-padding-inline: var(--organisms--step-container-padding-x, var(--spacing-sm, 20px));--organisms-pbl-banner-margin-top: var(--spacing-xs, 8px);--organisms-pbl-banner-margin-inline: var(--spacing-auto, auto);--organisms-pbl-banner-margin-bottom: var(--spacing-none, 0px);--organisms-pbl-banner-width: var(--size-pbl-banner-width, 90vw);--organisms-pbl-banner-max-width: var(--size-pbl-banner-max-width, 1248px);--organisms-pbl-banner-gap: var(--spacing-md, 24px);--organisms-pbl-banner-background: var(--color-background-senary, #f9f9f9);--organisms-pbl-banner-padding-y: var(--spacing-3xl, 56px);--organisms-pbl-banner-padding-x: var(--spacing-sm, 16px);--organisms-pbl-banner-shadow: var(--shadow-pbl-banner, 0 0 4px 1px rgba(0, 0, 0, .1));--organisms-pbl-banner-direction: var(--pbl-direction-column);--organisms-pbl-banner-align: var(--pbl-align-center);--organisms-pbl-banner-justify: var(--pbl-justify-center);--organisms-pbl-banner-text-align: var(--pbl-text-align-center);--organisms-pbl-banner-tablet-margin-top: var(--spacing-lg, 32px);--organisms-pbl-banner-heading-transform: var(--text-transform-uppercase);--organisms-pbl-banner-paragraph-weight: var(--font-weight-regular, 400);--organisms-pbl-banner-paragraph-margin-y: var(--spacing-none, 0px);--organisms-pbl-banner-paragraph-margin-x: var(--spacing-auto, auto);--organisms-pbl-banner-paragraph-max-width: var(--size-pbl-banner-paragraph-max, 600px);--organisms-pbl-banner-success-padding-top: var(--spacing-lg, 32px);--organisms-pbl-banner-success-align: var(--pbl-text-align-center);--organisms-pbl-banner-success-transform: var(--text-transform-uppercase);--organisms-pbl-banner-success-tablet-padding-top: var( --size-pbl-success-tablet-padding-top, var(--spacing-2xl, 48px) );--organisms-hero-container-content-125-ratio-top: 32px;--organisms-hero-container-content-125-ratio-right: 24px;--organisms-hero-container-content-125-ratio-bottom: 32px;--organisms-hero-container-content-125-ratio-left: 24px;--organisms-address-list-address-card-background-color: var(--white-100);--organisms-address-list-address-card-border-color: var(--border-default);--organisms-address-list-address-card-text-color: var(--text-default);--organisms-address-list-address-card-label-font-family: var(--typography-font-family-primary);--organisms-address-list-address-card-label-font-weight: 600;--organisms-address-list-address-card-label-font-size: .75rem;--organisms-address-list-address-card-default-label-margin-top: .5rem;--organisms-address-list-status-padding: 2rem}',Qp={en:{title:\"Title\",\"request-return-title\":\"Request a return or exchange\",\"introduction-text\":\"Please complete the details below to initiate a return. If the product has been purchased as a gift, ensure you provide your details, rather than the recipients’ details. All returns will be processed in accordance with the terms in our <conditionLink></conditionLink>\",\"introduction-text-car\":\"Please complete the details below to initiate a return. If the product was purchased as a gift, please provide the details of the initial purchaser. Please note that personalized products and fragrances are not eligible for return. All returns will be processed in accordance with our <conditionLink></conditionLink>\",gender:\"Gender\",\"ms-mrs\":\"Ms-Mrs\",mr:\"Mr\",other:\"Other\",name:\"Name\",surname:\"Surname\",\"email-address\":\"Email address\",\"return-type\":\"Return type\",\"return-reason\":\"Return Reason\",\"order-number\":\"Order number\",\"submit-btn\":\"SUBMIT REQUEST\",comment:\"Your comment\",\"comment-placeholder\":\"Please enter the reference number for the product you are returning. If you are requesting an exchange, kindly also specify the reference number of the new product you would like.\",\"privacy-policy-notice\":'By clicking \"Submit request\", we will use your data to process your request in accordance with our <privacyLink></privacyLink>',\"additional-text\":\"Our Clients Relations Center  will contact you shortly to provide your return number and facilitate the scheduling of your carrier pick-up. To ensure a smooth return process, please await our contact before returning any products.\",\"conditions-sales\":\"Conditions of Sales\",\"privacy-policy\":\"Privacy Policy\",\"success-title\":\"Thank you\",\"success-message\":\"Your form has been successfully submitted.\",\"return-type-options\":{\"return-all-items\":\"Return all products\",\"partial-return\":\"Partial return\",exchange:\"Exchange\"},\"return-reason-options\":{\"dont-like-reason\":\"Don't like it\",\"wrong-size-small-reason\":\"Wrong size (too small)\",\"wrong-size-big-reason\":\"Wrong size (too big)\",\"gift-receiver-reason\":\"Gift Receiver\",\"right-of-withdrawal-reason\":\"Right of withdrawal\",\"other-reason\":\"Other\"},error:{\"field-required\":\"This field is required\",\"gender-required\":\"This gender is required\",\"name-required\":\"The name field is required\",\"surname-required\":\"The surname field is required\",\"email-required\":\"The email address field is required\",\"email-invalid\":\"Please provide a valid email address\",\"order-number-required\":\"The order number field is required\",\"submission-error\":\"An error occurred while submitting your request. Please try again.\"}},de:{title:\"Titel\",\"request-return-title\":\"Eine Rücksendung oder einen Umtausch anfordern\",\"introduction-text\":\"Bitte füllen Sie die untenstehenden Informationen aus, um eine Rücksendung zu veranlassen. Wenn das Produkt als Geschenk gekauft wurde, stellen Sie sicher, dass Sie Ihre Daten und nicht die des Empfängers angeben. Alle Rücksendungen werden gemäß unserer <conditionLink></conditionLink>\",\"introduction-text-car\":\"Bitte füllen Sie die untenstehenden Angaben aus. Wenn es sich bei der Bestellung um ein Geschenk handelt, geben Sie bitte die Daten des ursprünglichen Käufers an. Bitte beachten Sie, dass personalisierte Kreationen und Parfums von der Rückgabe ausgeschlossen sind. Alle Rücksendungen werden gemäß unserer allgemeinen <conditionLink></conditionLink>\",gender:\"Geschlecht\",\"ms-mrs\":\"Frau\",mr:\"Herr\",other:\"Divers\",name:\"Name\",surname:\"Nachname\",\"email-address\":\"E-Mail-Adresse\",\"return-type\":\"Art der Rücksendung\",\"return-reason\":\"Grund der Rücksendung\",\"order-number\":\"Bestellnummer\",\"submit-btn\":\"ANFRAGE EINREICHEN\",comment:\"Your comment\",\"conditions-sales\":\"Verkaufsbedingungen bearbeitet\",\"privacy-policy\":\"Datenschutzrichtlinie\",\"success-title\":\"Danke\",\"success-message\":\"Ihr Formular wurde erfolgreich übermittelt.\",\"comment-placeholder\":\"Bitte geben Sie die Referenznummer des Artikels ein, den Sie zurücksenden. Wenn Sie einen Umtausch wünschen, geben Sie bitte auch die Referenznummer des gewünschten Artikels an.\",\"privacy-policy-notice\":'Durch Klicken auf \"Anfrage senden\" verwenden wir Ihre Daten zur Bearbeitung Ihrer Anfrage gemäß unserer <privacyLink></privacyLink>',\"additional-text\":\"Unser Kundendienst wird Sie in Kürze kontaktieren, um Ihnen Ihre Rücksendenummer mitzuteilen und die Terminierung der Abholung durch den Kurier zu erleichtern. Um einen reibungslosen Rücksendeprozess zu gewährleisten, warten Sie bitte auf unsere Kontaktaufnahme, bevor Sie Artikel zurücksenden.\",\"return-type-options\":{\"return-all-items\":\"Alle Artikel zurücksenden\",\"partial-return\":\"Teilrücksendung\",exchange:\"Austausch\"},\"return-reason-options\":{\"dont-like-reason\":\"Gefällt nicht\",\"wrong-size-small-reason\":\"Falsche Größe (zu klein)\",\"wrong-size-big-reason\":\"Falsche Größe (zu groß)\",\"gift-receiver-reason\":\"Als Geschenk erhalten\",\"right-of-withdrawal-reason\":\"Widerrufsrecht\",\"other-reason\":\"Sonstiges\"},error:{\"field-required\":\"Das Feld ist erforderlich\",\"gender-required\":\"Geschlecht ist erforderlich\",\"name-required\":\"Das Namensfeld ist erforderlich\",\"surname-required\":\"Das Nachnamenfeld ist erforderlich\",\"email-required\":\"Das E-Mail-Adressfeld ist erforderlich\",\"email-invalid\":\"Bitte geben Sie eine gültige E-Mail-Adresse an\",\"order-number-required\":\"Bestellnummer ist erforderlich\",\"submission-error\":\"Beim Absenden Ihrer Anfrage ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut.\"}},es:{title:\"Título\",\"request-return-title\":\"Solicitar una devolución o un cambio\",\"introduction-text\":\"Por favor, complete los datos a continuación para iniciar una devolución. Si el producto ha sido comprado como regalo, asegúrese de usar sus datos, en lugar de los datos del destinatario. Todas las devoluciones se procesarán de conformidad con los términos de nuestras <conditionLink></conditionLink>\",\"introduction-text-car\":\"Por favor, complete los detalles a continuación para iniciar una devolución. Si el artículo fue comprado como regalo, por favor, proporcione los datos del comprador inicial. Tenga en cuenta que los artículos personalizados y las fragancias no son elegibles para devolución. Todas las devoluciones se procesarán de acuerdo con nuestras <conditionLink></conditionLink>\",gender:\"Género\",\"ms-mrs\":\"Señora\",mr:\"Señor\",other:\"Otro\",name:\"Nombre\",surname:\"Apellido\",\"email-address\":\"Dirección de correo electrónico\",\"return-type\":\"Tipo de devolución\",\"return-reason\":\"Motivo de devolución\",\"order-number\":\"Número de pedido\",\"submit-btn\":\"ENVIAR SOLICITUD\",comment:\"Tu comentario\",\"conditions-sales\":\"Condiciones de Venta\",\"privacy-policy\":\"Política de Privacidad\",\"success-title\":\"Gracias\",\"success-message\":\"Su formulario ha sido enviado con éxito.\",\"comment-placeholder\":\"Por favor, introduzca el número de referencia del artículo que va a devolver. Si solicita un cambio, indique también el número de referencia del nuevo artículo que desea.\",\"privacy-policy-notice\":'Al hacer clic en \"Enviar solicitud\", utilizaremos sus datos para procesar su solicitud de acuerdo con nuestra <privacyLink></privacyLink>',\"additional-text\":\"Le informamos que nuestro Servicio de Atención al Cliente se pondrá en contacto con usted en breve para proporcionarle el número de autorización de devolución y para ayudarle a programar la recogida de su artículo por parte del transportista. Para asegurar un proceso de devolución eficiente, le rogamos que espere nuestro contacto y la recepción del número de autorización antes de proceder con el envío de cualquier artículo.\",\"return-type-options\":{\"return-all-items\":\"Devolver todos los artículos\",\"partial-return\":\"Devolución parcial\",exchange:\"Intercambio\"},\"return-reason-options\":{\"dont-like-reason\":\"No me gusta\",\"wrong-size-small-reason\":\"Talla incorrecta (demasiado pequeño)\",\"wrong-size-big-reason\":\"Talla incorrecta (demasiado grande)\",\"gift-receiver-reason\":\"Recibido como regalo\",\"right-of-withdrawal-reason\":\"Derecho de desistimiento\",\"other-reason\":\"Otro\"},error:{\"field-required\":\"El campo es obligatorio\",\"gender-required\":\"El género es necesario\",\"name-required\":\"El nombre es obligatorio.\",\"surname-required\":\"El apellido es obligatorio.\",\"email-required\":\"La dirección de correo electrónico es obligatoria.\",\"email-invalid\":\"Por favor, proporcione una dirección de correo\",\"order-number-required\":\"El Número de pedido es obligatorio\",\"submission-error\":\"Se ha producido un error al enviar su solicitud. Por favor, inténtelo de nuevo.\"}},fr:{title:\"Titre\",\"request-return-title\":\"Demander un retour\",\"introduction-text\":\"Veuillez compléter les informations ci-dessous pour initier un retour. Si cet article a été acheté en cadeau, assurez-vous d'utiliser vos propres coordonnées, plutôt que celles du destinataire. Tous les retours seront traités conformément aux termes de nos <conditionLink></conditionLink>\",\"introduction-text-car\":\"Veuillez compléter les informations ci-dessous pour initier un retour. Si le produit a été acheté en cadeau, veuillez fournir les coordonnées de l'acheteur initial. Veuillez noter que les produits personnalisés et les parfums ne sont pas éligibles au retour. Tous les retours seront traités conformément à nos <conditionLink></conditionLink>\",gender:\"Genre\",\"ms-mrs\":\"Mme\",mr:\"Mr\",other:\"Autre\",name:\"Nom\",surname:\"Prénom\",\"email-address\":\"Adresse e-mail\",\"return-type\":\"Type de retour\",\"return-reason\":\"Motif du retour\",\"order-number\":\"Numéro de commande\",\"submit-btn\":\"Soumettre ma demande de retour\",comment:\"Votre commentaire\",\"conditions-sales\":\"Conditions Générales de Vente\",\"privacy-policy\":\"Politique de confidentialité\",\"success-title\":\"Merci\",\"success-message\":\"Votre formulaire a été soumis avec succès.\",\"comment-placeholder\":\"Veuillez saisir le numéro de référence du produit que vous retournez. Si vous demandez un échange, veuillez également spécifier le numéro de référence du nouveau produit que vous souhaitez.\",\"privacy-policy-notice\":\"En cliquant sur soumettre, nous utiliserons vos données aux fins de traitement de votre demande conformément à notre <privacyLink></privacyLink>\",\"additional-text\":\"Notre Centre de Relations Clientèle vous contactera sous peu pour vous fournir votre numéro de retour et faciliter la planification de l'enlèvement par le transporteur. Pour garantir un processus de retour fluide, veuillez attendre que l'on vous contacte avant de retourner tout produit.\",\"return-type-options\":{\"return-all-items\":\"Retourner tous les articles\",\"partial-return\":\"Retour partiel (préciser la référence de l'article)\",exchange:\"Échange\"},\"return-reason-options\":{\"dont-like-reason\":\"Ne me plaît pas\",\"wrong-size-small-reason\":\"Mauvaise taille (trop petit)\",\"wrong-size-big-reason\":\"Mauvaise taille (trop grand)\",\"gift-receiver-reason\":\"Cadeau reçu\",\"right-of-withdrawal-reason\":\"Droit de retractation\",\"other-reason\":\"Autre\"},error:{\"field-required\":\"Le champ est requis\",\"gender-required\":\"Votre civilité est requise.\",\"name-required\":\"Le nom est obligatoire.\",\"surname-required\":\"Le nom de famille est obligatoire.\",\"email-required\":\"L'adresse e-mail est obligatoire.\",\"email-invalid\":\"Veuillez fournir une adresse e-mail valide\",\"order-number-required\":\"Le numéro de commande est requis\",\"submission-error\":\"Une erreur s'est produite lors de l'envoi de votre demande. Veuillez réessayer.\"}},it:{title:\"Titolo\",\"request-return-title\":\"Richiedere un reso o un cambio\",\"introduction-text\":\"Si prega di compilare i dettagli sottostanti per avviare una richiesta di reso. Se l'acquisto è stato effettuato come regalo, assicurarsi di utilizzare i propri dati, anziché quelli del destinatario. Tutti i resi saranno elaborati in conformità con i termini delle nostre <conditionLink></conditionLink>\",\"introduction-text-car\":\"Per favore, compili i dettagli di seguito per avviare un reso. Se l'articolo è stato acquistato come regalo, si prega di fornire i dettagli dell'acquirente iniziale. Le ricordiamo che gli articoli personalizzati e i profumi non sono idonei al reso. Tutti i resi saranno elaborati in conformità con le nostre <conditionLink></conditionLink>\",gender:\"Genere\",\"ms-mrs\":\"Signora\",mr:\"Signore\",other:\"Altro\",name:\"Nome\",surname:\"Cognome\",\"email-address\":\"Indirizzo e-mail\",\"return-type\":\"Tipologia di reso\",\"return-reason\":\"Motivo del reso\",\"order-number\":\"Numero d'ordine\",\"submit-btn\":\"INVIA RICHIESTA\",comment:\"Il tuo commento\",\"conditions-sales\":\"Condizioni di Vendita\",\"privacy-policy\":\"Informativa sulla Privacy\",\"success-title\":\"Grazie\",\"success-message\":\"Il tuo modulo è stato inviato con successo.\",\"comment-placeholder\":\"Per favore, insersca il numero di riferimento dell'articolo che sta restituendo. Se vuole effettuare un cambio, La preghiamo di specificare anche il numero di riferimento del nuovo prodotto desiderato.\",\"privacy-policy-notice\":'Facendo clic su \"Invia richiesta\", utilizzeremo i tuoi dati per elaborare la tua richiesta in conformità con la nostra <privacyLink></privacyLink>',\"additional-text\":\"Il nostro Servizio Clienti La contatterà a breve per fornirLe il numero di reso e facilitare la programmazione del ritiro da parte del corriere. Per garantire un processo di reso agevole, La preghiamo di attendere il nostro contatto prima di restituire qualsiasi prodotto.\",\"return-type-options\":{\"return-all-items\":\"Restituire tutti gli articoli\",\"partial-return\":\"Reso parziale\",exchange:\"Scambio\"},\"return-reason-options\":{\"dont-like-reason\":\"Non mi piace\",\"wrong-size-small-reason\":\"Taglia sbagliata (troppo piccolo)\",\"wrong-size-big-reason\":\"Taglia sbagliata (troppo grande)\",\"gift-receiver-reason\":\"Ricevuto in regalo\",\"right-of-withdrawal-reason\":\"Diritto di recesso\",\"other-reason\":\"Altro\"},error:{\"field-required\":\"Il campo è obbligatorio\",\"gender-required\":\"Il genere è obbligatorio\",\"name-required\":\"Il nome è obbligatorio\",\"surname-required\":\"Il cognome è obbligatorio\",\"email-required\":\"L'indirizzo email è obbligatorio\",\"email-invalid\":\"Si prega di fornire un indirizzo email valido\",\"order-number-required\":\"Il campo del numero d'ordine è obbligatorio\",\"submission-error\":\"Si è verificato un errore durante l'invio della richiesta. Riprova.\"}},nl:{title:\"Titel\",\"request-return-title\":\"Een retour of omruiling aanvragen\",\"introduction-text\":\"Gelieve onderstaande gegevens in te vullen om een retourzending te starten. Indien dit als cadeau werd gekocht, zorg er dan voor dat u uw eigen gegevens gebruikt, in plaats van die van de ontvanger. Alle retourzendingen worden verwerkt in overeenstemming met de voorwaarden in onze <conditionLink></conditionLink>\",\"introduction-text-car\":\"Vult u alstublieft de onderstaande gegevens in. Als de bestelling een cadeau betreft, gelieve dan de gegevens van de oorspronkelijke koper op te geven. Houdt u er rekening mee dat gepersonaliseerde creaties en parfums van de retournering zijn uitgesloten. Alle retourzendingen worden verwerkt volgens onze algemene <conditionLink></conditionLink>\",gender:\"Geslacht\",\"ms-mrs\":\"Mevrouw\",mr:\"Meneer\",other:\"Ander\",name:\"Naam\",surname:\"Achternaam\",\"email-address\":\"E-mailadres\",\"return-type\":\"Type retourzending\",\"return-reason\":\"Reden van retour\",\"order-number\":\"Ordernummer\",\"submit-btn\":\"VERZOEK INDIENEN\",comment:\"Jouw opmerking\",\"conditions-sales\":\"Verkoopvoorwaarden\",\"privacy-policy\":\"Privacybeleid\",\"success-title\":\"Aanvraag ingediend\",\"success-message\":\"Bedankt. Uw retouraanvraag is succesvol ingediend.\",\"comment-placeholder\":\"Voert u het referentienummer in van het artikel dat u retourneert. Als u een omruiling aanvraagt, gelieve dan ook het referentienummer van het nieuwe artikel vermelden.\",\"privacy-policy-notice\":'Door op \"Verzoek indienen\" te klikken, gebruiken wij uw gegevens om uw verzoek te verwerken in overeenstemming met ons <privacyLink></privacyLink>',\"additional-text\":\"Onze Klantenservice zal spoedig contact met u opnemen om uw retournummer te verstrekken en de planning van de ophaling door de koerier te vergemakkelijken. Om een soepel retourproces te garanderen, verzoeken wij u te wachten op ons contact voordat u artikelen retourneert.\",\"return-type-options\":{\"return-all-items\":\"Alle artikelen retourneren\",\"partial-return\":\"Gedeeltelijke retour\",exchange:\"Aandelenbeurs\"},\"return-reason-options\":{\"dont-like-reason\":\"Niet naar wens\",\"wrong-size-small-reason\":\"Verkeerde maat (te klein)\",\"wrong-size-big-reason\":\"Verkeerde maat (te groot)\",\"gift-receiver-reason\":\"Als cadeau ontvangen\",\"right-of-withdrawal-reason\":\"Herroepingsrecht\",\"other-reason\":\"Overig\"},error:{\"field-required\":\"Het veld is vereist\",\"gender-required\":\"Geslacht is vereist\",\"name-required\":\"De voornaam is vereist.\",\"surname-required\":\"De achternaam is vereist.\",\"email-required\":\"Het e-mailadres is vereist.\",\"email-invalid\":\"Geef een geldig e-mailadres op\",\"order-number-required\":\"Het veld voor het ordernummer is verplicht.\",\"submission-error\":\"Er is een fout opgetreden tijdens het verzenden van uw verzoek. Probeer het opnieuw.\"}},pt:{title:\"Título\",\"request-return-title\":\"Pedido de devolução ou troca\",\"introduction-text\":\"Por favor, preencha os detalhes abaixo para iniciar uma devolução. Se esta compra foi feita como um presente, certifique-se de usar os seus dados, em vez dos dados do destinatário. Todas as devoluções serão processadas de acordo com os termos das nossas <conditionLink></conditionLink>\",\"introduction-text-car\":\"Por favor, preencha os dados abaixo para dar início a uma devolução. Caso o produto tenha sido adquirido como presente, por favor, indique os dados do comprador original. Tenha em atenção que produtos personalizados e fragrâncias não são passíveis de devolução. Todas as devoluções serão processadas de acordo com as nossas <conditionLink></conditionLink>\",gender:\"Gênero\",\"ms-mrs\":\"Senhora\",mr:\"Senhor\",other:\"Outro\",name:\"Nome\",surname:\"Sobrenome\",\"email-address\":\"Endereço de e-mail\",\"return-type\":\"Tipo de devolução\",\"return-reason\":\"Motivo da devolução\",\"order-number\":\"Número do pedido\",\"submit-btn\":\"ENVIAR PEDIDO\",comment:\"Seu comentário\",\"conditions-sales\":\"Condições de Venda\",\"privacy-policy\":\"Política de Privacidade\",\"success-title\":\"Pedido enviado\",\"success-message\":\"Obrigado. Seu pedido de devolução foi enviado com sucesso.\",\"comment-placeholder\":\"Por favor, introduza o número de referência do produto que está a devolver. Se estiver a solicitar uma troca, por favor, indique também o número de referência do novo produto que pretende.\",\"privacy-policy-notice\":'Ao clicar em \"Enviar pedido\", utilizaremos os seus dados para processar o seu pedido, em conformidade com a nossa <privacyLink></privacyLink>',\"additional-text\":\"O nosso Centro de Relações com o Cliente entrará em contacto consigo em breve para lhe fornecer o seu número de devolução e agilizar o agendamento da recolha por parte da transportadora. Para garantir um processo de devolução tranquilo e eficiente, solicitamos que aguarde o nosso contacto antes de proceder à devolução de quaisquer produtos.\",\"return-type-options\":{\"return-all-items\":\"Devolver todos os produtos\",\"partial-return\":\"Devolução parcial\",exchange:\"Intercâmbio\"},\"return-reason-options\":{\"dont-like-reason\":\"Não correspondeu às expectativas\",\"wrong-size-small-reason\":\"Tamanho errado (muito pequeno)\",\"wrong-size-big-reason\":\"Tamanho errado (muito grande)\",\"gift-receiver-reason\":\"Recebido como presente\",\"right-of-withdrawal-reason\":\"Direito de livre resolução\",\"other-reason\":\"Outro\"},error:{\"field-required\":\"O campo é obrigatório\",\"gender-required\":\"O gênero é obrigatório\",\"name-required\":\"O campo do nome é obrigatório.\",\"surname-required\":\"O campo do apelido é obrigatório\",\"email-required\":\"O campo do endereço de e-mail é obrigatório.\",\"email-invalid\":\"Por favor forneça um endereço de e-mail válido\",\"order-number-required\":\"O campo do número do pedido é obrigatório.\",\"submission-error\":\"Ocorreu um erro ao enviar sua solicitação. Tente novamente.\"}},sv:{title:\"Titel\",\"request-return-title\":\"Begär en retur eller ett byte\",\"introduction-text\":\"Vänligen fyll i uppgifterna nedan för att initiera en retur. Om produkten har köpts som en present, se till att du använder dina egna uppgifter, snarare än mottagarens uppgifter. Alla returer kommer att behandlas i enlighet med villkoren i våra <conditionLink></conditionLink>\",\"introduction-text-car\":\"Vänligen fyll i uppgifterna nedan, för att initiera en retur. Om produkten köptes som en gåva, vänligen ange uppgifterna för den ursprungliga köparen. Observera att personliga produkter och parfymer inte är berättigade till retur. Alla returer kommer att behandlas i enlighet med våra Allmänna <conditionLink></conditionLink>\",gender:\"Kön\",\"ms-mrs\":\"Fru\",mr:\"Herr\",other:\"Andra\",name:\"Namn\",surname:\"Efternamn\",\"email-address\":\"E-postadress\",\"return-type\":\"Returtyp\",\"return-reason\":\"Returorsak\",\"order-number\":\"Ordernummer\",\"submit-btn\":\"SKICKA FÖRFRÅGAN\",comment:\"Din kommentar\",\"conditions-sales\":\"försäljningsvillkor\",\"privacy-policy\":\"Integritetspolicy\",\"success-title\":\"Begäran har skickats\",\"success-message\":\"Tack. Din returbegäran har skickats in.\",\"comment-placeholder\":\"Vänligen ange referensnumret för produkten du returnerar. Om du begär ett byte, vänligen ange även referensnumret för den nya produkten du önskar.\",\"privacy-policy-notice\":'Genom att klicka på \"Skicka förfrågan\" använder vi dina uppgifter för att behandla din förfrågan i enlighet med vår <privacyLink></privacyLink>',\"additional-text\":\"Vårt kundrelationscenter kommer att kontakta dig inom kort för att ge dig ditt returnummer och underlätta schemaläggningen av din upphämtning. För att säkerställa en smidig returprocess, vänligen invänta vår kontakt innan du returnerar några produkter.\",\"return-type-options\":{\"return-all-items\":\"Returnera alla produkter\",\"partial-return\":\"Delvis retur\",exchange:\"Utbyta\"},\"return-reason-options\":{\"dont-like-reason\":\"Tycker inte om den\",\"wrong-size-small-reason\":\"Fel storlek (för liten)\",\"wrong-size-big-reason\":\"Fel storlek (för stor)\",\"gift-receiver-reason\":\"Fått som gåva\",\"right-of-withdrawal-reason\":\"Ångerrätt\",\"other-reason\":\"Annat\"},error:{\"field-required\":\"Fältet är obligatoriskt\",\"gender-required\":\"Kön är obligatoriskt\",\"name-required\":\"Namnfältet är obligatoriskt.\",\"surname-required\":\"Efternamnfältet är obligatoriskt.\",\"email-required\":\"E-postadressfältet är obligatoriskt.\",\"email-invalid\":\"Vänligen ange en giltig e-postadress\",\"order-number-required\":\"Fältet för ordernummer är obligatoriskt\",\"submission-error\":\"Ett fel uppstod när din begäran skickades. Försök igen.\"}}},Zp={en:{name:\"First Name\",surname:\"Last Name\",\"email-address\":\"E-Mail\",comment:\"Your comment\",\"success-title\":\"Thank you\",\"success-message\":\"Your form has been successfully submitted.\"},de:{title:\"Anrede\",name:\"Vorname\",\"email-address\":\"E-Mail\",comment:\"Ihr Kommentar\"},fr:{title:\"Salutation\",mr:\"M.\",\"email-address\":\"E-Mail\",comment:\"Votre commentaire\"},it:{title:\"Saluto\",mr:\"Sig.\",\"email-address\":\"E-Mail\",comment:\"Il tuo commento\"},es:{comment:\"Tu comentario\"}},Nh=(o,t)=>{const a=Qp[o]||Qp.en;if((t==null?void 0:t.toUpperCase())===\"VAC\"){const d=Zp[o]||Zp.en;return{...a,...d}}return a},Ge=o=>typeof o==\"string\",Xa=()=>{let o,t;const a=new Promise((d,n)=>{o=d,t=n});return a.resolve=o,a.reject=t,a},Xp=o=>o==null?\"\":\"\"+o,jh=(o,t,a)=>{o.forEach(d=>{t[d]&&(a[d]=t[d])})},Vh=/###/g,Jp=o=>o&&o.indexOf(\"###\")>-1?o.replace(Vh,\".\"):o,ec=o=>!o||Ge(o),Ja=(o,t,a)=>{const d=Ge(t)?t.split(\".\"):t;let n=0;for(;n<d.length-1;){if(ec(o))return{};const s=Jp(d[n]);!o[s]&&a&&(o[s]=new a),Object.prototype.hasOwnProperty.call(o,s)?o=o[s]:o={},++n}return ec(o)?{}:{obj:o,k:Jp(d[n])}},rc=(o,t,a)=>{const{obj:d,k:n}=Ja(o,t,Object);if(d!==void 0||t.length===1){d[n]=a;return}let s=t[t.length-1],c=t.slice(0,t.length-1),m=Ja(o,c,Object);for(;m.obj===void 0&&c.length;)s=`${c[c.length-1]}.${s}`,c=c.slice(0,c.length-1),m=Ja(o,c,Ob