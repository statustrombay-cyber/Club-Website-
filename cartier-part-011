logiere della Maison",button:{url:"/",label:"Iscriviti"}}},{type:"pushPageBlock",title:"Continua a esplorare",button:{url:"/",label:"Indietro"}}]}}),Xet=()=>({market:"Japan",title:"「ベニュワール」と「ミスト ドゥ カルティエ」",uri:"the-eye-of-the-jeweller",slug:"the-eye-of-the-jeweller",type:"product",loaded:1,watchSceneIndex:2,content:{blocks:[{type:"heroBlock",title:"「ベニュワール」と「ミスト ドゥ カルティエ」",subtitle:"ジュエラーとしての視点"},{type:"scrollMediasBlock",text:"カルティエの誇る時計技術は、ジュエリーのサヴォアフェールからも独創性やバイタリティを引き出し、モチーフとセッティングによってフォルムを際立たせます。",medias:[{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock1.webp",ariaLabel:"",subtitle:"クル ドゥ パリの装飾を施した仕上げ"},{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock2.webp",ariaLabel:"",subtitle:"リズム感と構造をもたらすモチーフ"},{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock3.webp",ariaLabel:"",subtitle:"五感に訴える着用体験"},{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock4.webp",ariaLabel:"",subtitle:"すべて手作業による研磨"},{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock5.webp",ariaLabel:"",subtitle:"象徴的なオーバルウォッチ"}]},{type:"scrollWatchBlock",texts:["ジュエラーとしての視点で、カルティエは、メゾンの代表的なクル ドゥ パリのモチーフでフォルムを美しく昇華させます。この革新的な試みを通して、カルティエは独自のサヴォアフェールを駆使し、創造性の可能性を押し広げました。","カルティエの熟練のジュエリー職人たちは、研磨の工程で、クリエイションに最高の輝きを与えます。この仕上げの工程はすべて手作業で行われ、極めて高い精度が求められます。"]},{type:"videoBlock",media:{url:"/videos/productPages/baignoire-and-Myst/videoBlock.mp4",type:"video",ariaLabel:""}},{type:"productsBlock",medias:[{url:"/images/productPages/baignoire-and-myst/productsBlock1.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/productsBlock2.webp",ariaLabel:""}]},{type:"scrollMediasBlock",text:"独創的なフォルムのウォッチ、「ミスト ドゥ カルティエ」は、こうした創造性の流れを汲み、意外性のある構造で神秘を表現しました。クラスプのないデザインは、トロンプルイユ（だまし絵）のブレスレットを思わせ、パールのようにつなぎ合わされたパーツは、タリスマンの佇まいを醸し出します。",medias:[{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock1-2.webp",ariaLabel:"",subtitle:""},{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock2-2.webp",ariaLabel:"",subtitle:"彫刻のようなウォッチ"},{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock3-2.webp",ariaLabel:"",subtitle:"ジュエリーとウォッチメイキングを結ぶ存在"},{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock4-2.webp",ariaLabel:"",subtitle:"ブラックラッカーが引き立てる大胆な視覚的要素"},{url:"/images/productPages/baignoire-and-myst/scrollMediasBlock5-2.webp",ariaLabel:"",subtitle:"トロンプルイユ（だまし絵）のブレスレット"}]},{type:"textBlock",text:"ジュエリー職人はブレスレットに、ビーズセッティングを採用し、サイズの異なるストーンを用いて奥行きやボリュームを表現しました。この緻密な構造をつくり上げるには、石留めに最大47時間を要します。"},{type:"sliderBlock",layoutVariant:"landscape",medias:[{url:"/images/productPages/baignoire-and-myst/sliderBlock1.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/sliderBlock2.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/sliderBlock3.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/sliderBlock4.webp",ariaLabel:""}]},{type:"productsBlock",text:"メゾンのもつ2つの専門技術により、カルティエのジュエリーウォッチは、高貴にストーンセッティングを施したモチーフの美しさと、極上の着用感を叶える人間工学を追求したフォルムを両立しています。",medias:[{url:"/images/productPages/baignoire-and-myst/productsBlock1-2.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/productsBlock2-2.webp",ariaLabel:""}]},{type:"sliderProductsBlock",title:"コレクションを見る",cards:[{title:"「パンテール ドゥ カルティエ」ウォッチ",url:"https://www.cartier.jp/ja/collections/watches/all-watches/panthere-de-cartier/wjpn0059-panthere-de-cartier-watch.html",media:{ariaLabel:"",url:"/images/productPages/baignoire-and-myst/sliderProductsBlock1.webp"}},{title:"「ベニュワール」ウォッチ",url:"",media:{ariaLabel:"",url:"/images/productPages/baignoire-and-myst/sliderProductsBlock2.webp"}},{title:"「ベニュワール」ウォッチ",url:"",media:{ariaLabel:"",url:"/images/productPages/baignoire-and-myst/sliderProductsBlock3.webp"}},{title:"「タンク アメリカン」ウォッチ",url:"",media:{ariaLabel:"",url:"/images/productPages/baignoire-and-myst/sliderProductsBlock4.webp"}}],cta:{url:"",label:""}},{type:"textBlock",text:"インスタグラムからCartier Watch Communityに登録する",textSize:"m",subtitle:"@cartierwatchcommunity"},{type:"sliderBlock",medias:[{url:"/images/