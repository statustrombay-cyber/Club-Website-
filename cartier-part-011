 漆艺师以激光雕刻图案，并手工填涂漆料，再经高温烧制，最终呈现细腻效果。`,image:{name:"myst-de-cartier"},mask:{url:"myst-de-cartier_mask.png",width:570,height:720},audio:"/audio/podcasts/master_13.mp3",loaded:1}]}),pO=Object.freeze(Object.defineProperty({__proto__:null,ar_ae:W7e,ar_kw:U7e,ar_qa:j7e,ar_sa:F7e,br_br:H7e,de_at:Q7e,de_ch:V7e,de_de:G7e,en_ae:q7e,en_al:K7e,en_ar:Y7e,en_at:J7e,en_au:X7e,en_aw:$7e,en_bb:Z7e,en_be:eqe,en_bg:tqe,en_bl:aqe,en_bs:rqe,en_ca:iqe,en_ch:sqe,en_cl:oqe,en_co:nqe,en_cr:lqe,en_cy:cqe,en_cz:uqe,en_de:dqe,en_dk:hqe,en_do:pqe,en_ec:mqe,en_ee:gqe,en_es:fqe,en_fi:bqe,en_fr:wqe,en_gb:yqe,en_gr:vqe,en_gt:kqe,en_hk:Aqe,en_hr:_qe,en_hu:Bqe,en_ie:Cqe,en_il:Pqe,en_in:Tqe,en_int:xqe,en_is:Sqe,en_it:Eqe,en_jm:Mqe,en_kw:Lqe,en_ky:Iqe,en_lt:Rqe,en_lu:Dqe,en_lv:Oqe,en_mc:Nqe,en_mt:zqe,en_my:Wqe,en_nl:Uqe,en_no:jqe,en_nz:Fqe,en_pa:Hqe,en_pe:Qqe,en_pl:Vqe,en_pr:Gqe,en_pt:qqe,en_qa:Kqe,en_ro:Yqe,en_rs:Jqe,en_sa:Xqe,en_se:$qe,en_sg:Zqe,en_si:eKe,en_sk:tKe,en_th:aKe,en_tr:rKe,en_us:iKe,en_uy:sKe,en_vi:oKe,es_ar:nKe,es_aw:lKe,es_bs:cKe,es_cl:uKe,es_co:dKe,es_cr:hKe,es_do:pKe,es_ec:mKe,es_es:gKe,es_gt:fKe,es_jm:bKe,es_mx:wKe,es_pa:yKe,es_pe:vKe,es_pr:kKe,es_uy:AKe,fr_be:_Ke,fr_ca:BKe,fr_ch:CKe,fr_fr:PKe,fr_lu:TKe,fr_mc:xKe,it_ch:SKe,it_it:EKe,jp_jp:MKe,ko_kr:LKe,nl_be:IKe,nl_nl:RKe,pt_pt:DKe,ru_ru:OKe,sv_se:NKe,th_th:zKe,tr_tr:WKe,zh_cn:UKe,zh_hk:jKe,zh_tw:FKe,zhs_hk:HKe,zhs_sg:QKe},Symbol.toStringTag,{value:"Module"})),VKe=()=>({market:"UAE",title:"كارتييه - معرض الساعات والعجائب",loader:"تكشف كارتييه عن جوهر خبرتها الفنّية في صناعة الساعات: إتقان فريد لهذه الخبرة الحِرفية التقليدية.",baseline:"صانعة الساعات ذات الأشكال المميّزة، خبيرة الفن",buttons:{allPicturesButton:{label:"كل الصور"}},ctas:{scroll:"الانتقال نحو الأسفل",listen:"الاستماع إلى The Sound of Craft",soundBttn:"الصوت",soundOn:"تشغيل الصوت للاستماع",clickEnableSound:"",explore:"الاستكشاف",watchMovie:"مشاهدة الفيلم",podcastText:"النص",close:"إغلاق"}}),GKe=()=>({market:"Koweit",title:"كارتييه - معرض الساعات والعجائب",loader:"تكشف كار