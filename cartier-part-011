",medias:[{url:"/images/productPages/baignoire-and-myst/productsBlock1-2.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/productsBlock2-2.webp",ariaLabel:""}]},{type:"sliderProductsBlock",title:"Découvrir la collection",cards:[{title:"PANTHÈRE DE CARTIER WATCH",url:"https://www.cartier.com/fr-mc/product/CRWJPN0059",media:{ariaLabel:"",url:"/images/productPages/baignoire-and-myst/sliderProductsBlock1.webp"}},{title:"BAIGNOIRE WATCH",url:"https://www.cartier.com/fr-mc/product/CRWJBA0046",media:{ariaLabel:"",url:"/images/productPages/baignoire-and-myst/sliderProductsBlock2.webp"}},{title:"BAIGNOIRE WATCH",url:"https://www.cartier.com/fr-mc/product/CRWJBA0053",media:{ariaLabel:"",url:"/images/productPages/baignoire-and-myst/sliderProductsBlock3.webp"}},{title:"TANK AMÉRICAINE WATCH",url:"https://www.cartier.com/fr-mc/product/CRWJTA0056",media:{ariaLabel:"",url:"/images/productPages/baignoire-and-myst/sliderProductsBlock4.webp"}}],cta:{url:"",label:""}},{type:"textBlock",text:"Rejoindre Cartier Watch Community sur Instagram",textSize:"m",subtitle:"@cartierwatchcommunity"},{type:"sliderBlock",medias:[{url:"/images/productPages/baignoire-and-myst/sliderBlock1-2.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/sliderBlock2-2.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/sliderBlock3-2.webp",ariaLabel:""},{url:"/images/productPages/baignoire-and-myst/sliderBlock4-2.webp",ariaLabel:""}]},{type:"textBlock",text:"Plus d’informations sur Baignoire et Myst",textSize:"m",button:[{url:"https://www.cartier.com/fr-mc/collections/watches/creative-capsules",label:""},{url:"+330142184383",label:"Contactez votre ambassadeur",type:"ambassador"}],textBlockType:"contact",media:{url:"/images/productPages/roadster/newsletterBlock.webp",ariaLabel:""}},{type:"newsletterBlock",media:{url:"/images/productPages/baignoire-and-myst/newsletterBlock.webp",ariaLabel:""},card:{title:"Restez informés",text:"Pour tout savoir sur les nouveautés horlogè