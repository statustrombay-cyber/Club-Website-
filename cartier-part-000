                            var regexExclusion = new RegExp(settings.ccMaskExclusions[k], "gi");
                            if (match.match(regexExclusion)) {
                                continue mainloop; //matches an exception
                            }
                        }
                    }
                    
                    str = str.replace(match, match.replace(/\d/g, "*"));
                }
            }

        }

        return str;
    }

